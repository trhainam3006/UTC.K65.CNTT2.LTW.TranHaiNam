@model IEnumerable<TH_Lab6.Models.Major>
@{
    bool ajaxMode = ViewData["AjaxMode"] is bool b && b;
    int? selectedMajorId = ViewData["SelectedMajorID"] is int id ? id : null;
    string keyword = ViewData["Keyword"] as string ?? "";
    string actionName = ajaxMode ? "Index" : "Sync";
}
<ul id="majorFilters" class="major-list" aria-label="Chọn ngành học">
    <li class="nav-item major-item @(selectedMajorId == null ? "active" : "")" data-major-id="">
        <a asp-controller="Learner" asp-action="@actionName"
           asp-route-keyword="@keyword" class="nav-link major-filter">Tất cả</a>
    </li>
    @foreach (var m in Model)
    {
        <li class="nav-item major-item @(selectedMajorId == m.MajorID ? "active" : "")"
            data-major-id="@m.MajorID">
            <a asp-controller="Learner" asp-action="@actionName"
               asp-route-mid="@m.MajorID" asp-route-keyword="@keyword"
               class="nav-link major-filter">@m.MajorName</a>
        </li>
    }
</ul>
