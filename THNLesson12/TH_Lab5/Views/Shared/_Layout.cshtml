@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Learner";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TH_Lab5</title>
    <link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
</head>
<body>
    <header class="app-header">
        <a class="brand" asp-controller="Learner" asp-action="Index">
            <span class="brand-mark">S</span>
            <span>Management System <small>TH_Lab5</small></span>
        </a>
        
    </header>
    <div class="app-shell">
        <aside class="sidebar" aria-label="Điều hướng">
            <div class="menu-category">CORE</div>
            <a asp-controller="Learner" asp-action="Index" class="side-link @(controller == "Learner" && action == "Index" ? "active" : "")">▦ <span>Danh sách Learner</span></a>
            <a asp-controller="Learner" asp-action="Ajax" class="side-link @(controller == "Learner" && action == "Ajax" ? "active" : "")">↻ <span>Lọc ngành bằng AJAX</span></a>
            <div class="menu-category">ADDONS</div>
            <a asp-controller="Learner" asp-action="Create" class="side-link @(controller == "Learner" && action == "Create" ? "active" : "")">＋ <span>Thêm Learner</span></a>
            <a asp-controller="Student" asp-action="Index" class="side-link @(controller == "Student" ? "active" : "")">✓ <span>Validation Lab3</span></a>
            
        </aside>
        <div class="page-column">
            <main role="main" class="page-main">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success" role="status">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }
                @RenderBody()
            </main>
            <footer class="footer">TH_Lab5</footer>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
