@model IEnumerable<TH_Lab5.Models.Learner>
<div class="table-scroll">
<table class="table table-striped" aria-label="Danh sách người học">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Tên</th>
            <th>Họ</th>
            <th>Ngành</th>
            <th>Ngày nhập học</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.LearnerID</td>
                <td>@s.FirstMidName</td>
                <td>@s.LastName</td>
                <td>@s.Major?.MajorName</td>
                <td>@s.EnrollmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="action-cell">
                    <a asp-controller="Learner" asp-action="Edit" asp-route-id="@s.LearnerID">Edit</a>
                    <span> | </span>
                    <a asp-controller="Learner" asp-action="Delete" asp-route-id="@s.LearnerID">Delete</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="empty-state">Không có người học thuộc ngành đã chọn.</td></tr>
        }
    </tbody>
</table>
</div>
