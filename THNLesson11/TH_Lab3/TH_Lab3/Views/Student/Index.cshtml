@model IEnumerable<TH_Lab3.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h2>DANH SÁCH SINH VIÊN</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Thêm sinh viên
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã SV</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ chính quy</th>
            <th>Địa chỉ</th>
            <th>Ngày sinh</th>
            <th>Điểm</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Branch</td>
                <td>@item.Gender</td>
                <td>@(item.IsRegular ? "Có" : "Không")</td>
                <td>@item.Address</td>
                <td>@item.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                <td>@item.Score</td>
            </tr>
        }
    </tbody>
</table>
