@model TH_Lab4.Models.Learner

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-4">
    <h2>Create</h2>

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <form asp-controller="Learner"
          asp-action="Create"
          method="post">

        <div class="mb-3">
            <label asp-for="FirstMidName"
                   class="form-label">
                First Mid Name
            </label>

            <input asp-for="FirstMidName"
                   class="form-control"
                   placeholder="First Mid Name" />

            <span asp-validation-for="FirstMidName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LastName"
                   class="form-label">
                Last Name
            </label>

            <input asp-for="LastName"
                   class="form-control"
                   placeholder="Last Name" />

            <span asp-validation-for="LastName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MajorID"
                   class="form-label">
                Ngành học
            </label>

            <select asp-for="MajorID"
                    asp-items="ViewBag.MajorID"
                    class="form-select">
                <option value="">-- Chọn ngành --</option>
            </select>

            <span asp-validation-for="MajorID"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EnrollmentDate"
                   class="form-label">
                Ngày nhập học
            </label>

            <input asp-for="EnrollmentDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="EnrollmentDate"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Create
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
