@model TH_Lab4.Models.Learner

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-4">

    <h2>Delete</h2>

    <h4 class="text-danger">
        Are you sure you want to delete this?
    </h4>

    <h5>Learner</h5>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            First Mid Name
        </dt>
        <dd class="col-sm-9">
            @Model.FirstMidName
        </dd>

        <dt class="col-sm-3">
            Last Name
        </dt>
        <dd class="col-sm-9">
            @Model.LastName
        </dd>

        <dt class="col-sm-3">
            Major
        </dt>
        <dd class="col-sm-9">
            @Model.Major?.MajorName
        </dd>

        <dt class="col-sm-3">
            Enrollment Date
        </dt>
        <dd class="col-sm-9">
            @Model.EnrollmentDate.ToString("dd/MM/yyyy")
        </dd>
    </dl>

    <form asp-controller="Learner"
          asp-action="Delete"
          asp-route-id="@Model.LearnerID"
          method="post">

        <input type="hidden" asp-for="LearnerID" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>
    </form>
</div>
