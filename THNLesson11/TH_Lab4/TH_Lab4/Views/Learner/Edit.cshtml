@model TH_Lab4.Models.Learner

@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-4">
    <h2>Edit Learner</h2>

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <form asp-controller="Learner"
          asp-action="Edit"
          asp-route-id="@Model.LearnerID"
          method="post">

        <input type="hidden" asp-for="LearnerID" />

        <div class="mb-3">
            <label asp-for="FirstMidName"
                   class="form-label">
                First Mid Name
            </label>

            <input asp-for="FirstMidName"
                   class="form-control" />

            <span asp-validation-for="FirstMidName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LastName"
                   class="form-label">
                Last Name
            </label>

            <input asp-for="LastName"
                   class="form-control" />

            <span asp-validation-for="LastName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MajorID"
                   class="form-label">
                Ngành học
            </label>

            <select asp-for="MajorID"
                    asp-items="ViewBag.MajorID"
                    class="form-select">
            </select>

            <span asp-validation-for="MajorID"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EnrollmentDate"
                   class="form-label">
                Ngày nhập học
            </label>

            <input asp-for="EnrollmentDate"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="EnrollmentDate"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Edit
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
