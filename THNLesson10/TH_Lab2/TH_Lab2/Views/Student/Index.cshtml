@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model IEnumerable<TH_Lab2.Models.Student>

<div class="container-fluid px-4">
    <h1 class="mt-4">Students Management</h1>
    <a asp-route="StudentAdd" class="btn btn-primary mb-3">Create Student</a>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Danh sách sinh viên
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Họ tên</th>
                        <th>Ngày sinh</th>
                        <th>Ngành</th>
                        <th>Giới tính</th>
                        <th>Hệ ĐT</th>
                        <th>Địa chỉ</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td>@s.Name</td>
                            <td>@s.DateOfBorth</td>
                            <td>
                                @{
                                    string str = "";
                                    switch (s.Branch)
                                    {
                                        case TH_Lab2.Models.Branch.IT:
                                            str = "CNTT";
                                            break;
                                        case TH_Lab2.Models.Branch.BE:
                                            str = "Kinh tế";
                                            break;
                                        case TH_Lab2.Models.Branch.CE:
                                            str = "Công trình";
                                            break;
                                        case TH_Lab2.Models.Branch.EE:
                                            str = "Điện - Điện tử";
                                            break;
                                    }
                                }
                                @str
                            </td>
                            <td>@(s.Gender == TH_Lab2.Models.Gender.Male ? "Nam" : "Nữ")</td>
                            <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                            <td>@s.Address</td>
                            <td>@s.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick() {
            table.style.backgroundColor = "lightyellow";
        }
    </script>
}