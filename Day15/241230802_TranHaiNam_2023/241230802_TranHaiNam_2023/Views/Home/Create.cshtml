@model ThemHangHoa
@{
    ViewData["Title"] = "Thêm hàng hóa mới";
}
<div class="khung-them">
    <p>Trần Hải Nam</p>
    <h2>Thêm hàng hóa mới</h2>
    <form asp-controller="Home" asp-action="Create" method="post">
        <div>
            <label asp-for="MaLoai"></label>
            <select asp-for="MaLoai" asp-items="ViewBag.CacLoai">
                <option value="">-- Chọn loại hàng --</option>
            </select>
            <span asp-validation-for="MaLoai"></span>
        </div>
        <div>
            <label asp-for="TenHang"></label>
            <input asp-for="TenHang" />
            <span asp-validation-for="TenHang"></span>
        </div>
        <div>
            <label asp-for="Gia"></label>
            <input asp-for="Gia" type="text" inputmode="numeric" />
            <span asp-validation-for="Gia"></span>
        </div>
        <div>
            <label asp-for="Anh"></label>
            <input asp-for="Anh" placeholder="Img_1.jpg" />
            <span asp-validation-for="Anh"></span>
        </div>
        <button type="submit">Create</button>
        <a asp-action="Index">Về danh sách</a>
    </form>
</div>
